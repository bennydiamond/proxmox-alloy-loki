{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Loki datasource receiving the Proxmox logs",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "3.0.0"
    }
  ],
  "title": "Proxmox Logs",
  "description": "Proxmox node logs split into host and per-guest (VM / LXC) views.",
  "tags": [
    "proxmox",
    "loki",
    "alloy"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "query": "label_values({job=\"proxmox\"}, host)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "scope",
        "label": "Scope",
        "type": "custom",
        "query": "host,guest",
        "description": "host = Proxmox itself; guest = lines about a VM or container.",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "guest",
        "label": "Guest",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "query": "label_values({job=\"proxmox\", host=~\"$node\", scope=\"guest\"}, guest_name)",
        "refresh": 2,
        "sort": 1,
        "description": "Only applies to guest lines; host lines have no guest.",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "query": "label_values({job=\"proxmox\", host=~\"$node\", scope=~\"$scope\", guest_name=~\"$guest\"}, service_name)",
        "refresh": 2,
        "sort": 7,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "level",
        "label": "Severity",
        "type": "custom",
        "description": "\"unknown\" = the source does not send a level.",
        "query": "critical,error,warn,info,debug,unknown",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "search",
        "label": "Contains",
        "type": "textbox",
        "query": "",
        "description": "Case-insensitive text filter",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Log lines",
      "description": "Lines matching all filters.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"proxmox\", host=~\"$node\", scope=~\"$scope\", guest_name=~\"$guest\", service_name=~\"$service\"} | level=~\"$level\" |~ `(?i)${search:regex}` [$__range]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Errors",
      "description": "critical + error lines (ignores Severity).",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"proxmox\", host=~\"$node\", scope=~\"$scope\", guest_name=~\"$guest\", service_name=~\"$service\"} | level=~\"critical|error\" |~ `(?i)${search:regex}` [$__range]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Failed tasks",
      "description": "Proxmox tasks (backup, start, stop, migrate ...) that ended in TASK ERROR.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"proxmox\", host=~\"$node\", service_name=\"pve-task\"} |= \"TASK ERROR\" [$__range]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "OOM kills / panics",
      "description": "Memory kills or kernel panics on the node or in a VM's serial console.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"proxmox\", host=~\"$node\"} |~ \"(?i)oom-kill|killed process|out of memory|kernel panic\" [$__range]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "dark-red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Log volume by severity",
      "description": "Red/orange spikes show when something went wrong. Drag to zoom.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (count_over_time({job=\"proxmox\", host=~\"$node\", scope=~\"$scope\", guest_name=~\"$guest\", service_name=~\"$service\"} | level=~\"$level\" |~ `(?i)${search:regex}` [$__auto]))",
          "legendFormat": "{{level}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "info"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "debug"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "unknown"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8e8e8e"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 15,
        "x": 0,
        "y": 4
      },
      "id": 5
    },
    {
      "type": "table",
      "title": "Services — click to select",
      "description": "Who logs most on the node.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "topk(20, sum by (scope, service_name) (count_over_time({job=\"proxmox\", host=~\"$node\", scope=~\"$scope\", guest_name=~\"$guest\", service_name=~\"$service\"} | level=~\"$level\" |~ `(?i)${search:regex}` [$__range])))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "scope": 0,
              "service_name": 1,
              "Value #A": 2
            },
            "renameByName": {
              "scope": "Scope",
              "service_name": "Service",
              "Value #A": "Lines"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Lines",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Lines"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-BlPu"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show logs for ${__data.fields.Service}",
                    "url": "/d/proxmox-alloy-loki/?var-service=${__data.fields.Service}&${scope:queryparam}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 9,
        "x": 15,
        "y": 4
      },
      "id": 6
    },
    {
      "type": "table",
      "title": "Task results",
      "description": "qmstart / qmshutdown / vzdump (backup) / migrate ... and how they ended. Empty Guest = node-level task.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum by (guest_name, task, result) (count_over_time({job=\"proxmox\", host=~\"$node\", service_name=\"pve-task\"} | regexp `(?P<result>TASK (?:OK|ERROR|WARNINGS))` [$__range]))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "guest_name": 0,
              "task": 1,
              "result": 2,
              "Value #A": 3
            },
            "renameByName": {
              "guest_name": "Guest",
              "task": "Task",
              "result": "Result",
              "Value #A": "Count"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Count",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Count"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-BlPu"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "id": 7
    },
    {
      "type": "table",
      "title": "Guests — click to select",
      "description": "VMs and containers the node logged about.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum by (guest_name, guest_type, guest_id) (count_over_time({job=\"proxmox\", host=~\"$node\", scope=\"guest\"} [$__range]))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "guest_name": 0,
              "guest_type": 1,
              "guest_id": 2,
              "Value #A": 3
            },
            "renameByName": {
              "guest_name": "Guest",
              "guest_type": "Type",
              "guest_id": "ID",
              "Value #A": "Lines"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Lines",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Lines"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-BlPu"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Guest"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show logs for ${__data.fields.Guest}",
                    "url": "/d/proxmox-alloy-loki/?var-scope=guest&var-guest=${__data.fields.Guest}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "id": 8
    },
    {
      "type": "logs",
      "title": "Guest events (starts, stops, backups, console)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "description": "Newest first. Click a line for its labels and metadata.",
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "maxLines": 500,
          "expr": "{job=\"proxmox\", host=~\"$node\", scope=\"guest\", guest_name=~\"$guest\"} |~ `(?i)${search:regex}` | line_format `{{ .guest_name }} · {{ __line__ }}`"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "enableInfiniteScrolling": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 9
    },
    {
      "type": "table",
      "title": "Top recurring errors / warnings",
      "description": "Most frequent problems for the current filters. Numbers are replaced by N so identical messages group together.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "topk(15, sum by (msg_pattern) (count_over_time({job=\"proxmox\", host=~\"$node\", scope=~\"$scope\", guest_name=~\"$guest\", service_name=~\"$service\"} | level=~\"critical|error|warn\" |~ `(?i)${search:regex}` | label_format msg_pattern=`{{ trunc 120 (regexReplaceAll \"[0-9]+\" (regexReplaceAll \"[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}\" (regexReplaceAll \"'[^']*'\" (regexReplaceAll \"[{].*\" (regexReplaceAll \"[0-9]{4}-[0-9]{2}-[0-9]{2}[ T][0-9:.,]+ ?\" (regexReplaceAll \"(^| )(ts|t|traceID|org_id|duration|time_ms|tid)=[^ ]+\" (regexReplaceAll \"^[^ ]+ [^ ]+ \" __line__ \"\") \"\") \"\") \"{...}\") \"<s>\") \"<mac>\") \"N\") }}` [$__range])))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "msg_pattern": 0,
              "Value #A": 1
            },
            "renameByName": {
              "msg_pattern": "Message pattern",
              "Value #A": "Lines"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Lines",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Lines"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "min",
